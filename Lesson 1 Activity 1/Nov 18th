def tall_sum(n, acc = 0):
    if n == 0:
        return acc
    return tall_sum(n-1, acc + n)

input("Tall recusrion - the last action is the recursion")
print(" tall_sum(4) = ", tall_sum(4), " = 4 + 3 + 2 + 1")
print(" tall_sum(5) = ", tall_sum(5), " = 5 + 4 + 3 + 2 + 1")

